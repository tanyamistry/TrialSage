# Copy this file to `.env` and edit as needed:  cp .env.example .env
# .env is gitignored. This file is the checked-in template.

# --- Database ------------------------------------------------------------
POSTGRES_USER=trialsage
POSTGRES_PASSWORD=trialsage
POSTGRES_DB=trialsage
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# The read-only role the text-to-SQL agent connects as. It can only SELECT
# from the whitelisted views -- it has no write grants anywhere in the DB.
READONLY_USER=trialsage_ro
READONLY_PASSWORD=change_me_readonly

# --- LLM provider --------------------------------------------------------
# One of: ollama | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Optional per-component override. Leave blank to use LLM_PROVIDER/LLM_MODEL.
# If Phase 2 shows local SQL generation is unreliable, set just these two.
SQL_LLM_PROVIDER=
SQL_LLM_MODEL=

# Only needed if you switch a provider above to anthropic/openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
